DATABASE_URL="postgresql://postgres:postgres@localhost:5432/photaaz"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-strong-secret"
BETTER_AUTH_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_ROOT_FOLDER="photaaz"
# Optional. Defaults to "development" unless NODE_ENV is production.
CLOUDINARY_ENVIRONMENT_FOLDER="development"

# Supabase is used for realtime chat/notifications only.
# Local development can still use the Docker PostgreSQL DATABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_REALTIME_ENABLED="false"

PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# Email delivery. Use "disabled" locally until SMTP or Resend is configured.
EMAIL_PROVIDER="disabled"
EMAIL_FROM_NAME="Photaaz"
EMAIL_FROM_ADDRESS="hello@example.com"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="starttls"
