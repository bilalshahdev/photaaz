generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  CUSTOM
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum CategoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum BlogModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ConversationSenderRole {
  ADMIN
  CLIENT
  SYSTEM
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum LegalRequestType {
  ACCESS
  EXPORT
  CORRECTION
  DELETION
  OBJECTION
  COPYRIGHT
  COUNTER_NOTICE
}

enum LegalRequestStatus {
  OPEN
  VERIFYING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model Tenant {
  id               String                    @id @default(cuid())
  ownerUserId      String?
  name             String
  slug             String                    @unique
  status           TenantStatus              @default(ACTIVE)
  defaultLocale    String                    @default("en")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  albums           Album[]
  photos           Photo[]
  blogs            BlogPost[]
  blogCategories   BlogCategory[]
  categories       Category[]
  pages            Page[]
  settings         TenantSetting?
  domains          Domain[]
  subscription     Subscription?
  notifications    ClientNotification[]
  conversations    ConversationThread[]
  visitorInquiries TenantInquiry[]
  categoryRequests PlatformCategoryRequest[]
  owner            User?                     @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([status, createdAt])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  tenants       Tenant[]  @relation("TenantOwner")
  legalAcceptances LegalAcceptance[]
  legalRequests LegalRequest[]
}

model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  locale         String
  ipAddressHash  String?
  userAgent      String?
  acceptedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([acceptedAt])
}

model LegalRequest {
  id              String             @id @default(cuid())
  userId          String?
  type            LegalRequestType
  status          LegalRequestStatus @default(OPEN)
  email           String
  name            String
  subject         String?
  details         String
  declaration     Boolean            @default(false)
  sourceUrl       String?
  workDescription String?
  locale          String             @default("en")
  ipAddressHash   String?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TenantSetting {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  themeKey        String    @default("minimal")
  primaryColor    String    @default("#207567")
  secondaryColor  String    @default("#E9EEF4")
  accentColor     String    @default("#E86845")
  headingFont     String    @default("Playfair Display")
  bodyFont        String    @default("Inter")
  navbarStyle     String    @default("centered")
  galleryStyle    String    @default("grid")
  cardStyle       String    @default("minimal")
  footerStyle     String    @default("simple")
  themeChangedAt  DateTime?
  businessDetails Json      @default("{}")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Album {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?
  categoryId  String?
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos      Photo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, published])
}

model Photo {
  id               String                @id @default(cuid())
  tenantId         String
  albumId          String?
  categoryId       String?
  title            String?
  alt              String
  cloudinaryId     String                @unique
  secureUrl        String
  width            Int?
  height           Int?
  dominantColor    String?
  moderationStatus PhotoModerationStatus @default(APPROVED)
  moderationNote   String?
  rightsConfirmed  Boolean               @default(false)
  rightsAcceptedAt DateTime?
  uploadIp         String?
  uploadUserAgent  String?
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  album            Album?                @relation(fields: [albumId], references: [id], onDelete: SetNull)
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId, albumId])
  @@index([tenantId, categoryId])
  @@index([moderationStatus, createdAt])
  @@index([tenantId, moderationStatus, createdAt])
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  image     String     @default("")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryChildren")
  albums    Album[]
  photos    Photo[]
  blogPosts BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model BlogCategory {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  description  String?
  displayOrder Int        @default(0)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts        BlogPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, displayOrder])
}

model BlogPost {
  id               String               @id @default(cuid())
  tenantId         String
  categoryId       String?
  blogCategoryId   String?
  title            String
  slug             String
  excerpt          String?
  content          Json
  featuredImage    String?
  metaTitle        String?
  metaDescription  String?
  tags             String[]             @default([])
  featured         Boolean              @default(false)
  publishedAt      DateTime?
  moderationStatus BlogModerationStatus @default(DRAFT)
  moderationNote   String?
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  blogCategory     BlogCategory?        @relation(fields: [blogCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, publishedAt])
  @@index([tenantId, moderationStatus, publishedAt])
  @@index([tenantId, blogCategoryId])
  @@index([moderationStatus, createdAt])
}

model Page {
  id              String   @id @default(cuid())
  tenantId        String
  type            PageType
  title           String
  slug            String
  sections        Json     @default("[]")
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(false)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, type])
}

model Domain {
  id              String       @id @default(cuid())
  tenantId        String
  hostname        String       @unique
  status          DomainStatus @default(PENDING)
  verificationTxt String?
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId])
  @@index([status, updatedAt])
}

model Plan {
  id                    String         @id @default(cuid())
  key                   String         @unique
  name                  String
  nameI18n              Json?
  description           String         @default("")
  descriptionI18n       Json?
  currency              String         @default("USD")
  monthlyPrice          Int?
  annualPrice           Int?
  lifetimePrice         Int?
  paddleProductId       String?        @unique
  paddleMonthlyPriceId  String?        @unique
  paddleAnnualPriceId   String?        @unique
  paddleLifetimePriceId String?        @unique
  gracePeriodDays       Int            @default(0)
  enabled               Boolean        @default(true)
  featured              Boolean        @default(false)
  displayOrder          Int            @default(0)
  features              PlanFeature[]
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([enabled, displayOrder])
}

model Feature {
  id              String        @id @default(cuid())
  key             String        @unique
  name            String
  nameI18n        Json?
  description     String?
  descriptionI18n Json?
  plans           PlanFeature[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean  @default(true)
  limit     Int?
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@index([featureId])
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  planId               String
  paddleCustomerId     String?
  paddleSubscriptionId String?            @unique
  paddleTransactionId  String?            @unique
  paddlePriceId        String?
  paddleStatus         String?
  cancelAtPeriodEnd    Boolean            @default(false)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnds    DateTime?
  adminNote            String?
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, currentPeriodEnds])
  @@index([planId])
}

model SecurityRateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @unique
  scope       String
  hits        Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@index([scope, windowStart])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  amount         Int
  enabled        Boolean    @default(true)
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([enabled, expiresAt])
}

model EmailSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  label           String
  labelI18n       Json?
  description     String?
  descriptionI18n Json?
  enabled         Boolean  @default(true)
  category        String   @default("system")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientNotification {
  id        String             @id @default(cuid())
  tenantId  String
  title     String
  body      String
  status    NotificationStatus @default(UNREAD)
  channel   String             @default("dashboard")
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([tenantId, status, createdAt])
}

model ConversationThread {
  id        String                @id @default(cuid())
  tenantId  String
  subject   String
  status    ConversationStatus    @default(OPEN)
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([tenantId, updatedAt])
  @@index([status, updatedAt])
}

model ConversationMessage {
  id             String                 @id @default(cuid())
  threadId       String
  senderRole     ConversationSenderRole
  body           String
  readByAdminAt  DateTime?
  readByClientAt DateTime?
  thread         ConversationThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())

  @@index([threadId, createdAt])
  @@index([senderRole, createdAt])
}

model TenantInquiry {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("Open")
  source    String   @default("contact_form")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([status, createdAt])
}

model Announcement {
  id            String   @id @default(cuid())
  title         String
  titleI18n     Json?
  body          String
  bodyI18n      Json?
  linkLabel     String?
  linkLabelI18n Json?
  linkHref      String?
  enabled       Boolean  @default(false)
  marquee       Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, displayOrder])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformTheme {
  id                 String   @id @default(cuid())
  name               String
  nameI18n           Json?
  slug               String   @unique
  description        String
  descriptionI18n    Json?
  image              String
  features           String[] @default([])
  featuresI18n       Json?
  iconKey            String   @default("camera")
  enabled            Boolean  @default(true)
  premium            Boolean  @default(false)
  demoPath           String
  displayOrder       Int      @default(0)
  customization      Json     @default("{}")
  seoTitle           String?
  seoTitleI18n       Json?
  seoDescription     String?
  seoDescriptionI18n Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([enabled, displayOrder])
}

model PlatformPhotographyType {
  id               String                    @id @default(cuid())
  parentId         String?
  name             String
  nameI18n         Json?
  slug             String                    @unique
  image            String                    @default("")
  enabled          Boolean                   @default(true)
  categorySeed     Boolean                   @default(true)
  displayOrder     Int                       @default(0)
  parent           PlatformPhotographyType?  @relation("PlatformPhotographyTypeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children         PlatformPhotographyType[] @relation("PlatformPhotographyTypeChildren")
  categoryRequests PlatformCategoryRequest[] @relation("CategoryRequestParentType")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([enabled, displayOrder])
  @@index([parentId])
}

model PlatformCategoryRequest {
  id           String                   @id @default(cuid())
  tenantId     String
  parentTypeId String?
  name         String
  slug         String
  image        String                   @default("")
  note         String?
  status       CategoryRequestStatus    @default(PENDING)
  adminNote    String?
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentType   PlatformPhotographyType? @relation("CategoryRequestParentType", fields: [parentTypeId], references: [id], onDelete: SetNull)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([parentTypeId])
}

model PlatformSupportRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  status    String   @default("Open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model PlatformBlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        Json
  excerpt      Json
  coverImage   String
  readTime     Json
  keywords     Json      @default("{}")
  sections     Json      @default("[]")
  enabled      Boolean   @default(false)
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled, publishedAt])
  @@index([featured, displayOrder])
}
