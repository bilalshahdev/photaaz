{
  "name": "bs-photos-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma scripts *.ts *.mjs",
    "test": "npm run test:security",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:product": "tsx --test tests/product/*.test.ts",
    "test:release": "npm run test:security && npm run test:product",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "perf:baseline": "node scripts/perf-smoke.mjs --out=.tmp/perf-baseline.json --allow-failures=true",
    "staging:check": "node scripts/staging-preflight.mjs",
    "paddle:setup": "tsx scripts/setup-paddle-catalog.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.49.8",
    "@tiptap/extension-code": "2.11.5",
    "@tiptap/extension-heading": "2.11.5",
    "@tiptap/extension-image": "2.11.5",
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/pm": "2.11.5",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.0",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.3",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.15.41": true,
    "@parcel/watcher@2.5.6": true,
    "prisma": true,
    "unrs-resolver": true,
    "@prisma/client": true,
    "@prisma/engines": true
  }
}
