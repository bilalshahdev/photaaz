PADDLE_PLUS_MONTHLY_PRICE_ID="pri_..."
PADDLE_PRO_MONTHLY_PRICE_ID="pri_..."
PADDLE_OWNERSHIP_PRICE_ID="pri_..."

EMAIL_PROVIDER="resend"
