NEXT_PUBLIC_ROOT_DOMAIN="staging.example.com"
BETTER_AUTH_URL="https://staging.example.com"
BETTER_AUTH_SECRET="GENERATE_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
SUPER_ADMIN_EMAIL="qa-admin@example.com"
SUPER_ADMIN_PASSWORD="USE_A_SEPARATE_STAGING_PASSWORD_AT_LEAST_12_CHARACTERS"

CLOUDINARY_CLOUD_NAME="YOUR_STAGING_CLOUD_OR_SHARED_CLOUD"
CLOUDINARY_API_KEY="STAGING_KEY"
CLOUDINARY_API_SECRET="STAGING_SECRET"
CLOUDINARY_ROOT_FOLDER="photaaz"
CLOUDINARY_ENVIRONMENT_FOLDER="staging"

PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY="pdl_sdbx_..."
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_..."
