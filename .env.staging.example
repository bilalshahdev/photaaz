NEXT_PUBLIC_SUPABASE_URL="https://STAGING_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="STAGING_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="STAGING_SERVICE_ROLE_KEY"
NEXT_PUBLIC_SUPABASE_REALTIME_ENABLED="true"
